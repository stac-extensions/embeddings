{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stac-extensions.github.io/embeddings/v0.0.1/schema.json#",
  "title": "Embedding Extension",
  "description": "STAC Embedding Extension for STAC Items and STAC Collections.",
  "oneOf": [
    {
      "title": "Embedding extension on STAC Items",
      "allOf": [
        {
          "$ref": "https://schemas.stacspec.org/v1.0.0/item-spec/json-schema/item.json"
        },
        {
          "$ref": "#/definitions/stac_extensions"
        },
        {
          "type": "object",
          "required": [
            "type",
            "properties",
            "assets"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "properties": {
              "$ref": "#/definitions/item_properties_fields"
            },
            "assets": {
              "type": "object",
              "required": [
                "embeddings"
              ],
              "additionalProperties": {
                "$ref": "#/definitions/asset_fields"
              }
            }
          }
        }
      ]
    },
    {
      "title": "Embedding extension on STAC Collections",
      "allOf": [
        {
          "$ref": "https://schemas.stacspec.org/v1.0.0/collection-spec/json-schema/collection.json"
        },
        {
          "$ref": "#/definitions/stac_extensions"
        },
        {
          "type": "object",
          "required": [
            "type",
            "emb:type",
            "emb:dimensions"
          ],
          "properties": {
            "type": {
              "const": "Collection"
            },
            "assets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/asset_fields"
              }
            },
            "item_assets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/asset_fields"
              }
            },
            "summaries": {
              "$ref": "#/definitions/summaries_fields"
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/collection_fields"
            }
          ]
        }
      ]
    }
  ],
  "definitions": {
    "stac_extensions": {
      "type": "object",
      "required": [
        "stac_extensions"
      ],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "contains": {
            "const": "https://stac-extensions.github.io/embeddings/v0.0.1/schema.json"
          }
        }
      }
    },
    "collection_fields": {
      "type": "object",
      "properties": {
        "emb:type": {
          "type": "string",
          "enum": [
            "pixel",
            "chip"
          ]
        },
        "emb:dimensions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "emb:chip_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "emb:stride": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "emb:grid_id": {
          "type": "string"
        },
        "emb:temporal_period": {
          "type": "string",
          "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$"
        },
        "emb:quantization_method": {
          "type": "string"
        },
        "emb:original_data_type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "item_properties_fields": {
      "type": "object",
      "properties": {
        "emb:spatial_coverage": {
          "type": "string"
        },
        "emb:chip_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "emb:stride": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "emb:grid_id": {
          "type": "string"
        },
        "emb:temporal_period": {
          "type": "string",
          "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$"
        },
        "emb:quantization_method": {
          "type": "string"
        },
        "emb:original_data_type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "asset_fields": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "summaries_fields": {
      "type": "object",
      "properties": {
        "emb:type": {},
        "emb:dimensions": {},
        "emb:chip_size": {},
        "emb:stride": {},
        "emb:grid_id": {},
        "emb:temporal_period": {},
        "emb:quantization_method": {},
        "emb:original_data_type": {}
      },
      
      "additionalProperties": true
    }
  }
}
