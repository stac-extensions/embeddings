{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stac-extensions.github.io/embeddings/v0.0.1/schema.json#",
  "title": "Embedding Extension",
  "description": "STAC Embedding Extension for STAC Items and STAC Collections.",
  "oneOf": [
    {
      "title": "Embedding extension on STAC Items",
      "allOf": [
        {
          "$ref": "https://schemas.stacspec.org/v1.0.0/item-spec/json-schema/item.json"
        },
        {
          "$ref": "#/definitions/stac_extensions"
        },
        {
          "type": "object",
          "required": [
            "type",
            "properties",
            "assets"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "properties": {
              "$ref": "#/definitions/item_properties_fields"
            },
            "assets": {
              "type": "object",
              "required": [
                "embeddings"
              ],
              "additionalProperties": {
                "$ref": "#/definitions/asset_fields"
              }
            }
          }
        }
      ]
    },
    {
      "title": "Embedding extension on STAC Collections",
      "allOf": [
        {
          "$ref": "https://schemas.stacspec.org/v1.0.0/collection-spec/json-schema/collection.json"
        },
        {
          "$ref": "#/definitions/stac_extensions"
        },
        {
          "type": "object",
          "required": [
            "type",
            "emb:type",
            "emb:dimensions"
          ],
          "properties": {
            "type": {
              "const": "Collection"
            },
            "assets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/asset_fields"
              }
            },
            "item_assets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/asset_fields"
              }
            },
            "summaries": {
              "$ref": "#/definitions/summaries_fields"
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/collection_fields"
            }
          ]
        }
      ]
    }
  ],
  "definitions": {
    "stac_extensions": {
      "type": "object",
      "required": [
        "stac_extensions"
      ],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "contains": {
            "const": "https://stac-extensions.github.io/embeddings/v0.0.1/schema.json"
          }
        }
      }
    },
    "chip_layout": {
      "type": "object",
      "required": [
        "layout_type"
      ],
      "properties": {
        "layout_type": {
          "type": "string",
          "enum": [
            "regular_grid",
            "variable_grid",
            "named_grid"
          ]
        },
        "chip_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "stride": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "grid_id": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^(?!emb:)": {}
      },
      "additionalProperties": false
    },
    "quantization": {
      "type": "object",
      "required": [
        "method",
        "original_dtype"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "original_dtype": {
          "type": "string"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "quantized_dtype": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "collection_fields": {
      "type": "object",
      "properties": {
        "emb:type": {
          "type": "string",
          "enum": [
            "pixel",
            "chip"
          ]
        },
        "emb:dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "emb:chip_layout": {
          "$ref": "#/definitions/chip_layout"
        },
        "emb:temporal_resolution": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^(?!emb:)": {}
      },
      "additionalProperties": false
    },
    "item_properties_fields": {
      "type": "object",
      "properties": {
        "emb:spatial_coverage": {
          "type": "string"
        },
        "emb:quantization": {
          "$ref": "#/definitions/quantization"
        }
      },
      "patternProperties": {
        "^(?!emb:)": {}
      },
      "additionalProperties": false
    },
    "asset_fields": {
      "type": "object",
      "properties": {},
      "patternProperties": {
        "^(?!emb:)": {}
      },
      "additionalProperties": false
    },
    "summaries_fields": {
      "type": "object",
      "properties": {
        "emb:type": {},
        "emb:dimensions": {},
        "emb:temporal_resolution": {}
      },
      "patternProperties": {
        "^(?!emb:)": {}
      },
      "additionalProperties": false
    }
  }
}
